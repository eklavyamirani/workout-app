# Workout App Docker Compose Environment
# Copy to deploy/.env and customize for your environment. deploy/.env is gitignored.
#
# Passwords are NOT set here. They are mounted as files from deploy/secrets/
# (see deploy/README.md): secrets/postgres-password and secrets/app-role-password.
#
# Frontend deployment configuration is not built into the image either; it is mounted
# from deploy/runtime-config.json.

# Authentik identity provider
AUTHENTIK_SECRET_KEY=change-me-in-production
AUTHENTIK_DB_PASSWORD=authentik
AUTHENTIK_BOOTSTRAP_PASSWORD=admin
AUTHENTIK_BOOTSTRAP_EMAIL=admin@localhost
AUTHENTIK_BOOTSTRAP_TOKEN=test-admin-token

# Deployment
DEPLOYMENT_MODE=production
